														"code" : "Param density;\r\nParam position;\r\nParam size;\r\nParam pitch;\r\nParam spread;\r\nParam spray;\r\n\r\nBuffer smpl(\"smpl2\");\r\nBuffer window(\"window\");\r\nData info2(30, 5);\r\nvoices = 30; \r\n\r\n\r\np = phasor(density);\r\np = delta(p) < 0;\r\n\r\nc = counter(p, in1, voices); \r\n\r\n\r\nout_main = 0;\r\n\r\nfor(i=0; i<voices;i+= 1){\r\n\t\r\n\tcurrent_check = (c== i);\r\n\tprev_check = peek(info2, i , 0);\r\n\tpoke(info2, current_check,i,0);\r\n\t\r\n\ttrigger = (current_check - prev_check) ==1;\r\n\t\r\n\tcount = peek(info2, i ,1);\r\n\tcount = trigger? 0 : count + 1;\r\n\tpoke(info2, count, i, 1);\r\n\t\r\n\tsz = mstosamps(size);\r\n\tif(trigger) {\r\n\t\tpoke(info2, sz, i, 2);\r\n\t\t}\r\n\telse {\r\n\t\tsz = peek(info2, i ,2);\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t\r\n\tphase = min(1, count/sz);\r\n\t\r\n\t\r\n\tamp = 0.5 - 0.5 * cos(phase * twopi);\r\n\t//amp = sample(window,phase, boundmode=\"wrap\");\r\n\tsprd = \tnoise() * 12 * spread;\r\n\tptch = pow(2,(sprd+pitch)/12);\r\n\tif(trigger){\r\n\t\tpoke(info2,ptch,i,3);\r\n\t\t\r\n\t\t} else {\r\n\t\t\tptch = peek(info2,i, 3); \r\n\t\t\t}\r\n\t\t\r\n\tspry = noise() * 0.5 * spray;  \t\t\r\n\tstart_pos = (position+spry) * dim(smpl);\r\n\t\r\n\tif(trigger){\r\n\t\tpoke(info2,start_pos,i,4);\r\n\t\t} else {\r\n\t\t\tstart_pos = peek(info2, i ,4);\r\n\t\t\t}\r\n\t\t\t\r\n\tplayhead = start_pos + (count *ptch);\r\n\t\t\t\r\n\t\r\n\tsmp = peek(smpl, playhead, 0, index=\"samples\", interp=\"cubic\", boundmode =\"wrap\");\r\n\t\r\n\tgrain = amp * smp;\r\n\t\r\n\tout_main += grain;\r\n\t\r\n\t\r\n\t\r\n\t}\r\n\r\nout1 = out_main;"
													}

												}
