						"boxes" : [ 							{
								"box" : 								{
									"code" : "Param density(30, min=0, max=100);\r\nParam position(0, min=0, max=1);\r\nParam size(200, min=2, max=500);\r\nParam pitch(0, min=-48, max=48);\r\nParam spread(0, min=0, max=1);\r\nParam spray(0,min=0, max=1);\r\n\r\nBuffer smpl(\"smpl\");\r\nBuffer window(\"window\");\r\nData info(30, 5);\r\nvoices = 30; \r\n\r\np = phasor(density);\r\np = delta(p) < 0;\r\n\r\nc = counter(p, in1, voices); \r\n\r\n\r\nout_main = 0;\r\n\r\nfor(i=0; i<voices;i+= 1){\r\n\t\r\n\tcurrent_check = (c== i);\r\n\tprev_check = peek(info, i , 0);\r\n\tpoke(info, current_check,i,0);\r\n\t\r\n\ttrigger = (current_check - prev_check) ==1;\r\n\t\r\n\tcount = peek(info, i ,1);\r\n\tcount = trigger? 0 : count + 1;\r\n\tpoke(info, count, i, 1);\r\n\t\r\n\tsz = mstosamps(size);\r\n\tif(trigger) {\r\n\t\tpoke(info, sz, i, 2);\r\n\t\t}\r\n\telse {\r\n\t\tsz = peek(info, i ,2);\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t\r\n\tphase = min(1, count/sz);\r\n\t\r\n\t\r\n\tamp = 0.5 - 0.5 * cos(phase * twopi);\r\n\t//amp = sample(window,phase, boundmode=\"wrap\");\r\n\tsprd = \tnoise() * 12 * spread;\r\n\tptch = pow(2,(sprd+pitch)/12);\r\n\tif(trigger){\r\n\t\tpoke(info,ptch,i,3);\r\n\t\t\r\n\t\t} else {\r\n\t\t\tptch = peek(info,i, 3); \r\n\t\t\t}\r\n\t\t\r\n\tspry = noise() * 0.5 * spray;  \t\t\r\n\tstart_pos = (position+spry) * dim(smpl);\r\n\t\r\n\tif(trigger){\r\n\t\tpoke(info,start_pos,i,4);\r\n\t\t} else {\r\n\t\t\tstart_pos = peek(info, i ,4);\r\n\t\t\t}\r\n\t\t\t\r\n\tplayhead = start_pos + (count *ptch);\r\n\t\t\t\r\n\t\r\n\tsmp = peek(smpl, playhead, 0, index=\"samples\", interp=\"cubic\", boundmode =\"wrap\");\r\n\t\r\n\tgrain = amp * smp;\r\n\t\r\n\tout_main += grain;\r\n\t\r\n\t\r\n\t\r\n\t}\r\n\r\nout1 = out_main;",
									"fontface" : 0,
									"fontname" : "<Monospaced>",
									"fontsize" : 12.0,
